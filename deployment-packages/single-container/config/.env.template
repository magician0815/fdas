# FDAS单容器部署方案 - 环境变量配置模板
# 复制为 .env 使用
# ⚠️ 安全警告: 生产环境必须修改所有默认值！

# ==================== 数据库配置 ====================
# PostgreSQL密码（生产环境必须修改）
DB_PASSWORD=your-secure-db-password-here

# 数据库端口（可选暴露）
DB_PORT=5432

# ==================== 后端安全配置 ====================
# ⚠️ 必须至少32字符，可使用以下命令生成:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-this-in-production-min-32-characters

# ==================== 应用配置 ====================
# 调试模式（生产环境必须false）
DEBUG=false

# 应用HTTP端口
APP_PORT=8000

# ==================== CORS配置 ====================
# 允许的前端域名（JSON数组格式）
# 生产环境请修改为实际域名
ALLOWED_ORIGINS=["https://your-domain.com"]

# ==================== IP验证（可选） ====================
# 是否启用Session IP验证（生产建议true）
ENABLE_IP_VALIDATION=false

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==================== 安全警告 ====================
# ⚠️ SESSION_SECRET 必须至少32字符
# ⚠️ 生产环境必须修改DB_PASSWORD
# ⚠️ 首次登录后立即修改admin密码（默认admin123）
# ⚠️ ALLOWED_ORIGINS 必须配置为实际域名