# FDAS Database 环境变量配置模板
# 复制为 .env 使用

# ==================== PostgreSQL配置 ====================
# 数据库用户名
POSTGRES_USER=fdas

# 数据库密码（生产环境必须修改）
# ⚠️ 安全警告: 生产环境请使用强密码
POSTGRES_PASSWORD=fdas

# 数据库名称
POSTGRES_DB=fdas

# 数据目录（容器内）
PGDATA=/var/lib/postgresql/data/pgdata

# ==================== 连接配置 ====================
# 数据库端口
DB_PORT=5432

# ==================== 备份配置 ====================
# 备份目录
BACKUP_DIR=/var/backups/fdas

# 备份保留天数
BACKUP_RETENTION_DAYS=30