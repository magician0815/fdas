# FDAS Frontend 环境变量配置模板
# Vite构建时使用
# 复制为 .env.production 使用

# ==================== API配置 ====================
# 后端API地址
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket地址
VITE_WS_URL=ws://localhost:8000/ws

# ==================== 应用配置 ====================
# 应用标题
VITE_APP_TITLE=FDAS - 金融数据抓取与分析系统

# 应用版本
VITE_APP_VERSION=2.0.1

# ==================== 功能开关 ====================
# 是否启用离线缓存
VITE_ENABLE_OFFLINE_CACHE=true

# 是否启用图表绘制工具
VITE_ENABLE_DRAWING_TOOLS=true

# ==================== 默认设置 ====================
# 默认图表时间范围（天数）
VITE_DEFAULT_CHART_DAYS=30

# 默认数据刷新间隔（秒）
VITE_DEFAULT_REFRESH_INTERVAL=60