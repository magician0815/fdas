# FDAS Backend 环境变量配置模板
# 复制为 .env 使用
# 版本: 2.0.1

# ==================== 数据库配置 ====================
# PostgreSQL连接URL（异步驱动asyncpg）
DATABASE_URL=postgresql+asyncpg://fdas:fdas@localhost:5432/fdas

# ==================== Session安全配置 ====================
# ⚠️ 安全警告: SESSION_SECRET必须至少32字符，生产环境必须修改！
# 可使用以下命令生成随机密钥:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-this-in-production-min-32-characters

# ==================== 调试模式 ====================
# 生产环境必须设置为false
DEBUG=false

# ==================== CORS配置 ====================
# 允许的前端域名（JSON数组格式）
# 生产环境请修改为实际域名
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==================== 应用端口 ====================
APP_PORT=8000

# ==================== IP验证（可选） ====================
# 是否启用Session IP验证（生产建议true）
ENABLE_IP_VALIDATION=false

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==================== 缓存配置 ====================
# 缓存过期时间（秒）
CACHE_TTL_SECONDS=86400

# ==================== 数据采集配置 ====================
# 默认采集时间（cron格式）
DEFAULT_COLLECTION_CRON=0 18 * * *

# ==================== WebSocket配置 ====================
# WebSocket心跳间隔（秒）
WS_HEARTBEAT_INTERVAL=30
# WebSocket重连最大延迟（秒）
WS_RECONNECT_MAX_DELAY=30